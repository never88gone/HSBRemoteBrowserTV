                  <BuildableReference
                     BuildableIdentifier = "primary"
                     BlueprintIdentifier = "382CD6EE2F7CDE640015A355"
                     BuildableName = "HSBWatchCompanion.app"
                     BlueprintName = "HSBWatchCompanion"
