# ==============================================================================
# GitHub Actions CI/CD Secrets 模版文件 (公开示例)
# 
# 使用说明：
# 1. 在 GitHub 仓库设置中添加同名 Secrets:
#    Settings -> Secrets and variables -> Actions -> New repository secret
# 2. 依次添加下列 8 个密钥变量
# ==============================================================================

# 1. 签名与描述文件相关 (Base64 字符串)
BUILD_CERTIFICATE_BASE64=""          # Apple Distribution .p12 文件的 Base64 编码
P12_PASSWORD=""                      # .p12 证书导出密码
BUILD_PROVISION_PROFILE_BASE64=""    # 主 App App Store .mobileprovision 的 Base64
BUILD_WATCH_PROVISION_PROFILE_BASE64="" # Watch App .mobileprovision 的 Base64

# 2. App Store Connect API Key (用于 TestFlight 上传)
APP_STORE_CONNECT_KEY_ID=""          # API Key ID (10位字符)
APP_STORE_CONNECT_ISSUER_ID=""       # Issuer ID (UUID)
APP_STORE_CONNECT_KEY_CONTENT=""     # AuthKey_xxx.p8 文件内容或 Base64 字符串
APPLE_ID=""                          # Apple Developer 账号邮箱
