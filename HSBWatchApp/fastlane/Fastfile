# Fastfile for HSBRemoteBrowserTV (iOS & watchOS Companion)
# 参考 THLDance 工业级 CI/CD 与 TestFlight 分发标准

require "open3"
require "digest"
require "socket"

# 自动检测并注入本地代理以加速 App Store Connect 通信，杜绝 SSL 抖动
[6152, 7890, 7897, 1087].each do |port|
  begin
    s = TCPSocket.new('127.0.0.1', port)
    s.close
    ENV['http_proxy'] = "http://127.0.0.1:#{port}"
    ENV['https_proxy'] = "http://127.0.0.1:#{port}"
    ENV['ALL_PROXY'] = "http://127.0.0.1:#{port}"
    break
  rescue => e
  end
end

# 自动读取并注入本地私有 .env 环境变量（如果存在，仅用于本地调试；在云端 CI 时安全跳过）
['../../.env', '../.env', '.env'].each do |relative_path|
  env_path = File.expand_path(relative_path, __dir__)
  if File.exist?(env_path)
    begin
      content = File.read(env_path)
      content.scan(/^\s*([A-Za-z0-9_]+)\s*=\s*(?:"([\s\S]*?)"|'([\s\S]*?)'|([^\n#]+))/).each do |match|
        key = match[0]
        val = match[1] || match[2] || match[3]
        if key && val
          ENV[key.strip] = val
        end
      end
    rescue => e
    end
  end
end

TEAM_ID = "876385K952"
ENV["CERT_IGNORE_WWDR_CERTIFICATE"] = "true"

default_platform(:ios)

def get_asc_api_key
  key_id = ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"] || ENV["APP_STORE_CONNECT_KEY_ID"]
  issuer_id = ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"] || ENV["APP_STORE_CONNECT_ISSUER_ID"]
  key_content = ENV["APP_STORE_CONNECT_API_KEY_KEY"] || ENV["APP_STORE_CONNECT_API_KEY"] || ENV["APP_STORE_CONNECT_KEY_CONTENT"]
  key_filepath = ENV["ASC_API_KEY_P8_PATH"] || ENV["APP_STORE_CONNECT_API_KEY_KEY_FILEPATH"]

  if key_filepath && File.exist?(key_filepath)
    app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_filepath,
      in_house: false
    )
  elsif key_content && File.exist?(key_content)
    app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_content,
      in_house: false
    )
  elsif key_content
    is_base64 = !key_content.include?("BEGIN PRIVATE KEY")
    app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: key_content,
      is_key_content_base64: is_base64,
      in_house: false
    )
  else
    UI.user_error!("Missing App Store Connect API Key configuration")
  end
end

def verified_testflight_ipa
  archive_root = ENV["THLBROWSER_TESTFLIGHT_ARCHIVE_ROOT"].to_s
  build_number = ENV["THLBROWSER_TESTFLIGHT_BUILD_NUMBER"].to_s
  ipa_path = ENV["THLBROWSER_TESTFLIGHT_IPA_PATH"].to_s
  expected_sha = ENV["THLBROWSER_TESTFLIGHT_IPA_SHA256"].to_s

  if [archive_root, build_number, ipa_path, expected_sha].any?(&:empty?)
    UI.user_error!("TestFlight candidate is not explicit: set THLBROWSER_TESTFLIGHT_ARCHIVE_ROOT, THLBROWSER_TESTFLIGHT_BUILD_NUMBER, THLBROWSER_TESTFLIGHT_IPA_PATH and THLBROWSER_TESTFLIGHT_IPA_SHA256.")
  end

  verifier = ENV["CI_PROJECT_DIR"] ? File.join(ENV["CI_PROJECT_DIR"], "script/verify_testflight_candidate.sh") : File.expand_path("../../script/verify_testflight_candidate.sh", __dir__)
  stdout, stderr, status = Open3.capture3(
    verifier, "ios",
    "--archive-root", archive_root,
    "--build-number", build_number,
    "--ipa", ipa_path,
    "--sha256", expected_sha
  )
  unless status.success?
    UI.user_error!("TestFlight candidate verification failed. #{stderr.strip}")
  end

  frozen_line = stdout.lines.find { |line| line.start_with?("VERIFIED_IPA_PATH=") }
  UI.user_error!("Verifier returned no frozen IPA path") unless frozen_line
  frozen_ipa = frozen_line.delete_prefix("VERIFIED_IPA_PATH=").strip

  UI.message("Verified frozen iOS IPA, build #{build_number}, SHA-256 #{expected_sha}")
  frozen_ipa
end

platform :ios do
  desc "Upload verified iOS IPA to TestFlight (never rebuilds)"
  lane :upload_testflight do
    ipa = verified_testflight_ipa
    api_key = get_asc_api_key

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      skip_submission: true,
      beta_app_description: "糖葫芦大屏遥控器 (HSBRemoteBrowserTV) 测试更新",
      changelog: "更新大模型与 TV 控制系统通道稳定性",
      beta_app_feedback_email: "support@thltv.com",
      ipa: ipa
    )
    UI.success("🎉 TestFlight upload completed successfully!")
  end

  desc "Upload and sync App Store metadata and screenshots"
  lane :metadata do
    # 上传前本地校验截图合规性 (尺寸、Alpha 通道)
    validator = File.expand_path("validate_review_assets.rb", __dir__)
    stdout, stderr, status = Open3.capture3("ruby", validator)
    unless status.success?
      UI.user_error!("Screenshot asset validation failed:\n#{stderr}\n#{stdout}")
    end
    UI.message(stdout)

    api_key = get_asc_api_key
    UI.message("🚀 Syncing App Store Metadata & Screenshots...")
    deliver(
      api_key: api_key,
      skip_binary_upload: true,
      skip_screenshots: false,
      force: true,
      overwrite_screenshots: true,
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false
    )
    UI.success("🎉 App Store Metadata sync completed successfully!")
  end

  desc "Submit App Store Version 1.0.0 for Review"
  lane :submit_for_review do |options|
    validator = File.expand_path("validate_review_assets.rb", __dir__)
    stdout, stderr, status = Open3.capture3("ruby", validator)
    unless status.success?
      UI.user_error!("Screenshot asset validation failed:\n#{stderr}\n#{stdout}")
    end
    UI.message(stdout)

    api_key = get_asc_api_key
    target_build = options[:build_number] || "20261025092634"
    UI.message("🚀 正在将最新已就绪构建 (#{target_build}) 与中英文官方元数据提交至 App Store 审核...")

    attempts = 0
    begin
      attempts += 1
      deliver(
        api_key: api_key,
        build_number: target_build,
        skip_binary_upload: true,
        skip_screenshots: false,
        overwrite_screenshots: true,
        force: true,
        submit_for_review: true,
        automatic_release: true,
        run_precheck_before_submit: false,
        precheck_include_in_app_purchases: false,
        submission_information: {
          add_id_info_uses_idfa: false,
          export_compliance_uses_encryption: false,
          export_compliance_is_exempt: true
        }
      )
    rescue => e
      if attempts < 3
        UI.important("⚠️ 遇到瞬态网络异常: #{e.message}，正在 3 秒后自动重试 (第 #{attempts} 次)...")
        sleep 3
        retry
      else
        raise e
      end
    end
    UI.success("🎉 App Store 审核正式提交成功！")
  end

  desc "Check App Store Connect Status"
  lane :check_status do
    api_key = get_asc_api_key
    app = Spaceship::ConnectAPI::App.find("com.never88gone.thlbrowserios")
    if app
      UI.message("✅ 成功连通 App Store Connect！")
      UI.message("App 名称: #{app.name}")
      UI.message("App ID: #{app.id}")
      UI.message("Bundle ID: #{app.bundle_id}")
      versions = app.get_app_store_versions
      versions.each do |v|
        UI.message("  [App Store Version] #{v.version_string} -> #{v.app_store_state} (#{v.platform})")
        b = v.get_build rescue nil
        if b
          UI.message("    当前关联构建: #{b.version}")
        else
          UI.message("    当前未关联构建")
        end
      end
      builds = app.get_builds(limit: 5)
      builds.each do |b|
        UI.message("  [Available Build] #{b.version} (#{b.uploaded_date}) -> processing: #{b.processing_state}")
      end
    else
      UI.user_error!("未找到 bundle_id 为 com.never88gone.thlbrowserios 的 App")
    end
  end

  desc "Legacy local build and upload lane"
  lane :beta do
    repo_root = ENV["GITHUB_WORKSPACE"] || ENV["CI_PROJECT_DIR"] || File.expand_path("../..", __dir__)
    script_path = File.join(repo_root, "script/archive_app_store.sh")
    sh("bash \"#{script_path}\" ios --export")
    ipa_file = Dir.glob(File.join(repo_root, "Artifacts/AppStore/*/ios/export/*.ipa")).max_by { |f| File.mtime(f) }
    UI.user_error!("No exported IPA found in #{File.join(repo_root, 'Artifacts/AppStore')}") unless ipa_file

    if ENV["SKIP_TESTFLIGHT"] == "true"
      UI.success("⏭️ 已按要求跳过 TestFlight 上传 (SKIP_TESTFLIGHT=true)，IPA 已打包生成: #{ipa_file}")
    else
      api_key = get_asc_api_key
      upload_to_testflight(
        api_key: api_key,
        skip_waiting_for_build_processing: true,
        skip_submission: true,
        ipa: ipa_file
      )
    end
  end
end
