# Fastfile for HSBRemoteBrowserTV (iOS & watchOS Companion)
# 参考 THLDance 工业级 CI/CD 与 TestFlight 分发标准

require "open3"
require "digest"
require "socket"

# 自动检测并注入本地代理以加速 App Store Connect 通信，杜绝 SSL 抖动
[6152, 7890, 7897, 1087].each do |port|
  begin
    s = TCPSocket.new('127.0.0.1', port)
    s.close
    ENV['http_proxy'] = "http://127.0.0.1:#{port}"
    ENV['https_proxy'] = "http://127.0.0.1:#{port}"
    ENV['ALL_PROXY'] = "http://127.0.0.1:#{port}"
    break
  rescue => e
  end
end

# 自动读取并注入本地私有 .env 环境变量（如果存在，仅用于本地调试；在云端 CI 时安全跳过）
['../../.env', '../.env', '.env'].each do |relative_path|
  env_path = File.expand_path(relative_path, __dir__)
  if File.exist?(env_path)
    begin
      content = File.read(env_path)
      content.scan(/^\s*([A-Za-z0-9_]+)\s*=\s*(?:"([\s\S]*?)"|'([\s\S]*?)'|([^\n#]+))/).each do |match|
        key = match[0]
        val = match[1] || match[2] || match[3]
        if key && val
          ENV[key.strip] = val
        end
      end
    rescue => e
    end
  end
end

TEAM_ID = "876385K952"
ENV["CERT_IGNORE_WWDR_CERTIFICATE"] = "true"

default_platform(:ios)

def get_asc_api_key
  key_id = ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"] || ENV["APP_STORE_CONNECT_KEY_ID"]
  issuer_id = ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"] || ENV["APP_STORE_CONNECT_ISSUER_ID"]
  key_content = ENV["APP_STORE_CONNECT_API_KEY_KEY"] || ENV["APP_STORE_CONNECT_API_KEY"] || ENV["APP_STORE_CONNECT_KEY_CONTENT"]
  key_filepath = ENV["ASC_API_KEY_P8_PATH"] || ENV["APP_STORE_CONNECT_API_KEY_KEY_FILEPATH"]

  if key_filepath && File.exist?(key_filepath)
    app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_filepath,
      in_house: false
    )
  elsif key_content && File.exist?(key_content)
    app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_content,
      in_house: false
    )
  elsif key_content
    is_base64 = !key_content.include?("BEGIN PRIVATE KEY")
    app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_content: key_content,
      is_key_content_base64: is_base64,
      in_house: false
    )
  else
    UI.user_error!("Missing App Store Connect API Key configuration")
  end
end

def verified_testflight_ipa
  archive_root = ENV["THLBROWSER_TESTFLIGHT_ARCHIVE_ROOT"].to_s
  build_number = ENV["THLBROWSER_TESTFLIGHT_BUILD_NUMBER"].to_s
  ipa_path = ENV["THLBROWSER_TESTFLIGHT_IPA_PATH"].to_s
  expected_sha = ENV["THLBROWSER_TESTFLIGHT_IPA_SHA256"].to_s

  if [archive_root, build_number, ipa_path, expected_sha].any?(&:empty?)
    UI.user_error!("TestFlight candidate is not explicit: set THLBROWSER_TESTFLIGHT_ARCHIVE_ROOT, THLBROWSER_TESTFLIGHT_BUILD_NUMBER, THLBROWSER_TESTFLIGHT_IPA_PATH and THLBROWSER_TESTFLIGHT_IPA_SHA256.")
  end

  verifier = ENV["CI_PROJECT_DIR"] ? File.join(ENV["CI_PROJECT_DIR"], "script/verify_testflight_candidate.sh") : File.expand_path("../../script/verify_testflight_candidate.sh", __dir__)
  stdout, stderr, status = Open3.capture3(
    verifier, "ios",
    "--archive-root", archive_root,
    "--build-number", build_number,
    "--ipa", ipa_path,
    "--sha256", expected_sha
  )
  unless status.success?
    UI.user_error!("TestFlight candidate verification failed. #{stderr.strip}")
  end

  frozen_line = stdout.lines.find { |line| line.start_with?("VERIFIED_IPA_PATH=") }
  UI.user_error!("Verifier returned no frozen IPA path") unless frozen_line
  frozen_ipa = frozen_line.delete_prefix("VERIFIED_IPA_PATH=").strip

  UI.message("Verified frozen iOS IPA, build #{build_number}, SHA-256 #{expected_sha}")
  frozen_ipa
end

platform :ios do
  desc "Upload verified iOS IPA to TestFlight (never rebuilds)"
  lane :upload_testflight do
    ipa = verified_testflight_ipa
    api_key = get_asc_api_key

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
      skip_submission: true,
      beta_app_description: "糖葫芦大屏遥控器 (HSBRemoteBrowserTV) 测试更新",
      changelog: "更新大模型与 TV 控制系统通道稳定性",
      beta_app_feedback_email: "support@thltv.com",
      ipa: ipa
    )
    UI.success("🎉 TestFlight upload completed successfully!")
  end

  desc "Upload and sync App Store metadata and screenshots"
  lane :metadata do
    # 上传前本地校验截图合规性 (尺寸、Alpha 通道)
    validator = File.expand_path("validate_review_assets.rb", __dir__)
    stdout, stderr, status = Open3.capture3("ruby", validator)
    unless status.success?
      UI.user_error!("Screenshot asset validation failed:\n#{stderr}\n#{stdout}")
    end
    UI.message(stdout)

    api_key = get_asc_api_key
    UI.message("🚀 Syncing App Store Metadata & Screenshots...")
    deliver(
      api_key: api_key,
      skip_binary_upload: true,
      skip_screenshots: false,
      force: true,
      overwrite_screenshots: true,
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false
    )
    UI.success("🎉 App Store Metadata sync completed successfully!")
  end

  desc "Submit App Store Version 1.0.0 for Review"
  lane :submit_for_review do |options|
    validator = File.expand_path("validate_review_assets.rb", __dir__)
    stdout, stderr, status = Open3.capture3("ruby", validator)
    unless status.success?
      UI.user_error!("Screenshot asset validation failed:\n#{stderr}\n#{stdout}")
    end
    UI.message(stdout)

    api_key = get_asc_api_key
    target_build = options[:build_number] || "20261025092634"
    UI.message("🚀 正在将最新已就绪构建 (#{target_build}) 与中英文官方元数据提交至 App Store 审核...")

    attempts = 0
    begin
      attempts += 1
      deliver(
        api_key: api_key,
        build_number: target_build,
        skip_binary_upload: true,
        skip_screenshots: false,
        overwrite_screenshots: true,
        reject_if_possible: true,
        force: true,
        submit_for_review: true,
        automatic_release: true,
        run_precheck_before_submit: false,
        precheck_include_in_app_purchases: false,
        submission_information: {
          add_id_info_uses_idfa: false,
          export_compliance_uses_encryption: false,
          export_compliance_is_exempt: true
        }
      )
    rescue => e
      if attempts < 3
        UI.important("⚠️ 遇到瞬态网络异常: #{e.message}，正在 3 秒后自动重试 (第 #{attempts} 次)...")
        sleep 3
        retry
      else
        raise e
      end
    end
    UI.success("🎉 App Store 审核正式提交成功！")
  end

  desc "Check App Store Connect Status"
  lane :check_status do
    api_key = get_asc_api_key
    app = Spaceship::ConnectAPI::App.find("com.never88gone.thlbrowserios")
    if app
      UI.message("✅ 成功连通 App Store Connect！")
      UI.message("App 名称: #{app.name}")
      UI.message("App ID: #{app.id}")
      UI.message("Bundle ID: #{app.bundle_id}")
      versions = app.get_app_store_versions
      versions.each do |v|
        UI.message("  [App Store Version] #{v.version_string} -> #{v.app_store_state} (#{v.platform})")
        b = v.get_build rescue nil
        if b
          UI.message("    当前关联构建: #{b.version}")
        else
          UI.message("    当前未关联构建")
        end
      end
      builds = app.get_builds(limit: 5)
      builds.each do |b|
        UI.message("  [Available Build] #{b.version} (#{b.uploaded_date}) -> processing: #{b.processing_state}")
      end
    else
      UI.user_error!("未找到 bundle_id 为 com.never88gone.thlbrowserios 的 App")
    end
  end

  desc "Cancel current App Store submission"
  lane :cancel_submission do
    api_key = get_asc_api_key
    app = Spaceship::ConnectAPI::App.find("com.never88gone.thlbrowserios")
    if app
      UI.message("正在查找正在审核中的 Review Submissions...")
      begin
        resp = Spaceship::ConnectAPI.get_review_submissions(app_id: app.id)
        submissions = resp.to_models
        UI.message("找到 #{submissions.count} 个 Review Submissions")
        submissions.each do |sub|
          UI.message("ReviewSubmission ID: #{sub.id}, State: #{sub.state}")
          if ["WAITING_FOR_REVIEW", "IN_REVIEW", "SUBMITTED"].include?(sub.state)
            UI.message("🚨 正在取消 Review Submission: #{sub.id}...")
            sub.cancel_submission
            UI.success("🎉 已成功取消 Review Submission: #{sub.id}！")
          end
        end
      rescue => e
        UI.error("处理 Review Submissions 异常: #{e.message}\n#{e.backtrace.first(3).join("\n")}")
      end

      versions = app.get_app_store_versions
      versions.each do |v|
        UI.message("版本 #{v.version_string} 当前状态: #{v.app_store_state}")
      end
    end
  end

  desc "Check screenshots processing state"
  lane :check_screenshots_state do
    api_key = get_asc_api_key
    app = Spaceship::ConnectAPI::App.find("com.never88gone.thlbrowserios")
    version = app.get_app_store_versions.first
    locs = version.get_app_store_version_localizations
    total = 0
    pending = 0
    locs.each do |loc|
      sets = loc.get_app_screenshot_sets rescue []
      sets.each do |s|
        shots = s.get_app_screenshots rescue []
        shots.each do |shot|
          total += 1
          st = shot.asset_delivery_state["state"] rescue "UNKNOWN"
          if st != "COMPLETE"
            pending += 1
            UI.message("处理中: #{loc.locale} - #{s.screenshot_display_type} (ID: #{shot.id}) -> #{st}")
          end
        end
      end
    end
    UI.message("📊 当前总截图数: #{total}, 处理中数: #{pending}")
  end

  desc "Diagnose and submit review submission via Spaceship API"
  lane :diagnose_and_submit do |options|
    api_key = get_asc_api_key
    app = Spaceship::ConnectAPI::App.find("com.never88gone.thlbrowserios")
    version = app.get_app_store_versions.first
    target_build_number = options[:build_number] || "20261027132506"
    
    UI.message("App: #{app.name} (#{app.id}), Version: #{version.version_string} (#{version.id}), State: #{version.app_store_state}")
    
    # 查找构建
    target_build_number = options[:build_number] || "20261029015847"
    build = app.get_builds.find { |b| b.version == target_build_number }
    UI.user_error!("未找到构建: #{target_build_number}") unless build
    UI.message("找到目标构建: #{build.version} (#{build.id})")
    
    # 绑定构建到当前版本
    begin
      version.select_build(build_id: build.id)
      UI.success("✅ 成功绑定构建 #{build.version} 到版本 #{version.version_string}")
    rescue => e
      UI.important("绑定构建响应: #{e.message}")
    end

    # 更新 App Store 审核备注 (Notes) 为 Guideline 2.5.19 专项合规声明
    begin
      review_detail_resp = Spaceship::ConnectAPI.get_app_store_review_detail(app_store_version_id: version.id)
      review_detail = review_detail_resp.to_models.first
      if review_detail
        new_notes = <<~NOTES.strip
          Dear Apple App Review Team,

          Thank you for reviewing Tanghulu Remote!

          [Compliance Update Regarding Guideline 2.5.19]:
          In direct response to feedback regarding Guideline 2.5.19:
          - We have completely deleted all external JavaScript automation scripts (douyin_*.js, tencent_*.js) and removed the script execution toolbar (HSBBrowserScriptsBarView) from the app bundle.
          - We have purged all hardcoded stream playlist URLs (.m3u/.m3u8 sources) and removed the preset channel source recommendation section from the UI.
          - All bookmarks in the built-in home view are strictly limited to official, authorized search and knowledge portals (Apple, Bing, Wikipedia).
          - The app operates exclusively as a wireless hardware companion remote controller for Apple TV (Companion HID protocol) and Mac (native AirPlay media playback controls).

          [How to Test Without External TV / Mac Hardware]:
          To test all interactive capabilities without physical TV/Mac hardware:
          1. Launch the app on iPhone.
          2. Tap the Apple TV Remote icon on the top-right navigation bar to enter the full-featured remote controller interface:
             - System Remote Tab: 270pt tactile D-pad navigation wheel, center OK select, media controls (seek 10s back/forward, play/pause), volume steppers, and system buttons (Home, Menu, Mute, Standby) with native Taptic Engine feedback.
             - Interactive Tab: Wireless trackpad for large-screen presentation control with glide, scroll, and click interactions.
             - TV Remote Tab: Standard channel switching (CH+/-) and volume controls (VOL+/-) for smart displays.
             - Presentation Tab: Wireless slide turners (next/prev slide) and laser pointer annotation whiteboard.
             - Keyboard Drawer: Tap the keyboard button in the navigation bar to test synchronized text input.
          3. Tap the Gear icon (top-right) on the home screen to access Settings and the in-app Privacy Policy.

          [Real Hardware Pairing (Optional)]:
          - Apple TV: The app automatically discovers local Apple TVs via Bonjour; tap to pair using the on-screen 4-digit PIN.
          - Mac: Discovered Mac devices connect natively via AirPlay for system media playback and volume control without any external helper installation.

          [Privacy & Account]:
          - Zero login or registration required.
          - No subscriptions or in-app purchases; all features are completely free and unlocked.
          - Zero personal data is tracked or transmitted (100% compliant with Guideline 5.1).

          Thank you very much for your time and guidance!
        NOTES

        Spaceship::ConnectAPI.patch_app_store_review_detail(
          app_store_review_detail_id: review_detail.id,
          attributes: { notes: new_notes }
        )
        UI.success("✅ 成功更新 AppStoreReviewDetail 审核备注 (Notes)！")
      end
    rescue => e
      UI.error("更新审核备注异常: #{e.message}")
    end

    # 补全年龄分级 (Age Rating Declaration) 中缺失的必填属性 socialMedia
    begin
      app_info_resp = Spaceship::ConnectAPI.get_app_infos(app_id: app.id)
      app_info = app_info_resp.to_models.first
      if app_info
        UI.message("找到 AppInfo: #{app_info.id}")
        age_resp = Spaceship::ConnectAPI.get_age_rating_declaration(app_info_id: app_info.id)
        age_decl = age_resp.to_models.first
        if age_decl
          UI.message("找到 AgeRatingDeclaration (ID: #{age_decl.id}), 当前 socialMedia: #{age_decl.social_media.inspect}")
          Spaceship::ConnectAPI.patch_age_rating_declaration(
            age_rating_declaration_id: age_decl.id,
            attributes: {
              socialMedia: false,
              socialMediaAgeRestricted: false
            }
          )
          UI.success("✅ 成功补全 AgeRatingDeclaration socialMedia 属性为 false！")
        else
          UI.error("未找到 AgeRatingDeclaration")
        end
      else
        UI.error("未找到 AppInfo")
      end
    rescue => e
      UI.error("AgeRatingDeclaration 检查更新异常: #{e.message}\n#{e.backtrace.first(3).join("\n")}")
    end

    # 检查当前 review submissions
    resp = Spaceship::ConnectAPI.get_review_submissions(app_id: app.id)
    submissions = resp.to_models
    UI.message("当前共有 #{submissions.count} 个 Review Submissions")
    
    active_sub = nil
    submissions.each do |sub|
      UI.message("Submission #{sub.id} -> State: #{sub.state}")
      if ["UNRESOLVED_ISSUES", "RESOLVING_ISSUES"].include?(sub.state)
        UI.message("取消旧的被拒/未解决 Submission: #{sub.id}...")
        sub.cancel_submission rescue nil
      elsif sub.state == "READY_FOR_REVIEW"
        active_sub = sub
      end
    end

    if active_sub.nil?
      UI.message("创建新的 Review Submission...")
      begin
        new_sub_resp = Spaceship::ConnectAPI.post_review_submission(app_id: app.id, platform: "IOS")
        active_sub = new_sub_resp.to_models.first
        UI.success("✅ 成功创建新的 Review Submission: #{active_sub.id}")
      rescue => e
        UI.error("创建 Review Submission 失败: #{e.message}")
      end
    end

    # 等待苹果服务器完成所有截图后台处理 (直到无 processing 状态)
    UI.message("⏳ 正在等待苹果服务器完成截图转码处理...")
    15.times do |attempt|
      locs = version.get_app_store_version_localizations
      pending_count = 0
      locs.each do |loc|
        sets = loc.get_app_screenshot_sets rescue []
        sets.each do |s|
          shots = s.get_app_screenshots rescue []
          shots.each do |shot|
            st = shot.asset_delivery_state["state"] rescue "UNKNOWN"
            if st != "COMPLETE"
              pending_count += 1
            end
          end
        end
      end
      if pending_count == 0
        UI.success("🎉 所有截图已在苹果服务器处理完毕 (全部 COMPLETE)！")
        break
      else
        UI.message("仍有 #{pending_count} 张截图处理中... 等待 6 秒 (第 #{attempt + 1}/15 次)")
        sleep 6
      end
    end

    if active_sub
      # 检查是否有 items
      items = active_sub.get_items rescue []
      UI.message("当前 Submission 包含 #{items.count} 个 items")
      has_version_item = items.any? { |it| (it.app_store_version_id rescue nil) == version.id }
      
      unless has_version_item
        UI.message("将当前 App Store Version (#{version.id}) 添加到 Submission items...")
        item_added = false
        5.times do |item_attempt|
          begin
            Spaceship::ConnectAPI.post_review_submission_item(
              review_submission_id: active_sub.id,
              app_store_version_id: version.id
            )
            item_added = true
            UI.success("✅ 成功添加 Version 到 Review Submission items")
            break
          rescue => e
            UI.important("添加 item 尝试 #{item_attempt + 1}/5 失败: #{e.message}")
            sleep 8
          end
        end
        UI.user_error!("未能将 Version 添加到 Review Submission") unless item_added
      end

      # 提交审核
      UI.message("🚀 正在提交 Review Submission (#{active_sub.id}) 至 App Store 官方审核...")
      begin
        active_sub.submit_for_review
        UI.success("🎉 App Store 官方审核正式提交成功！状态已变为 WAITING_FOR_REVIEW！")
      rescue => e
        UI.error("提交审核异常: #{e.message}")
        raise e
      end
    end
  end

  desc "Legacy local build and upload lane"
  lane :beta do
    repo_root = ENV["GITHUB_WORKSPACE"] || ENV["CI_PROJECT_DIR"] || File.expand_path("../..", __dir__)
    script_path = File.join(repo_root, "script/archive_app_store.sh")
    sh("bash \"#{script_path}\" ios --export")
    ipa_file = Dir.glob(File.join(repo_root, "Artifacts/AppStore/*/ios/export/*.ipa")).max_by { |f| File.mtime(f) }
    UI.user_error!("No exported IPA found in #{File.join(repo_root, 'Artifacts/AppStore')}") unless ipa_file

    if ENV["SKIP_TESTFLIGHT"] == "true"
      UI.success("⏭️ 已按要求跳过 TestFlight 上传 (SKIP_TESTFLIGHT=true)，IPA 已打包生成: #{ipa_file}")
    else
      api_key = get_asc_api_key
      upload_to_testflight(
        api_key: api_key,
        skip_waiting_for_build_processing: true,
        skip_submission: true,
        ipa: ipa_file
      )
    end
  end
end
