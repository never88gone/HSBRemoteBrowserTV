# =========================================================================
# Fastlane 本地环境变量配置文件模版 (.env)
# 
# 使用说明：
# 1. 复制本文件并重命名为 `.env`（保存在同级目录下，即 HSBWatchApp/fastlane/.env）
# 2. 将下方的占位符替换为您真实的 Apple Developer 凭据信息
# 3. 运行 `fastlane beta` 时，Fastlane 会自动读取该文件，无需手动输入
# 
# ⚠️ 注意：`.env` 已被添加进 .gitignore，绝对不会被误提交，请放心填写！
# =========================================================================

# 1. Apple Store Connect API 密钥配置 (用于免双重验证 TestFlight 上传)
# 获取地址：https://appstoreconnect.apple.com/access/integrations/api
APP_STORE_CONNECT_KEY_ID=""
APP_STORE_CONNECT_ISSUER_ID=""

# 2. 下载的 AuthKey_xxx.p8 文件内的全部私钥内容
# 注意：dotenv 支持双引号包裹的多行内容，请完整拷贝 (包含 BEGIN 和 END 声明)
APP_STORE_CONNECT_KEY_CONTENT="-----BEGIN PRIVATE KEY-----
您的私钥多行内容第一行
您的私钥多行内容第二行
......
-----END PRIVATE KEY-----"

# 3. 您的 Apple ID 开发者邮箱 (安全防泄漏配置)
APPLE_ID="husanbo@gmail.com"
